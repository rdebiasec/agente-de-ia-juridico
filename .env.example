# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Modelo para redaccion/tutela (alto riesgo). Si vacio, usa OPENAI_MODEL.
OPENAI_MODEL_HIGH_RISK=gpt-4.1
# Modelo alterno para un reintento por timeout/error transitorio (vacío = mismo modelo).
OPENAI_MODEL_FALLBACK=
# Temperatura Agents SDK (ModelSettings). High-risk más baja.
AGENT_TEMPERATURE=0.2
AGENT_TEMPERATURE_HIGH_RISK=0.1
EMBEDDING_MODEL=text-embedding-3-small

# Slack (revisión humana / HITL del abogado)
# Docs: https://docs.slack.dev/tools/bolt-python/concepts/socket-mode
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_REVIEW_CHANNEL=#revision-abogado
# CSV de user IDs Slack (U…) autorizados a Aprobar/Editar/Rechazar. Vacío = cualquiera (solo local).
SLACK_APPROVER_IDS=
# Si false, borradores creados en web no se empujan a Slack (solo bandeja web).
SLACK_NOTIFY_WEB_DRAFTS=true

# Twilio SMS — alertas de plazos al móvil del abogado (transaccional)
# Recomendado: Messaging Service en producción (compliance + sender pool).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_ALERT_TO=
TWILIO_STATUS_CALLBACK=

# Persistencia (Fase B)
# Local (Postgres+pgvector vía Docker): levante `docker compose -f deploy/docker-compose.yml up -d db`
# y use esta URL cuando corre la app en la Mac (no dentro del contenedor app):
DATABASE_URL=postgresql+psycopg://agente:agente@localhost:5432/agente
# Local web: ./scripts/start-local.sh siempre levanta el servicio `db` de
# deploy/docker-compose.yml y fuerza esta URL. Vacío solo para tests unitarios.
# DATABASE_URL=
# Render/prod: render.yaml inyecta DATABASE_URL desde agente-ia-juridico-db (no hace falta en .env de prod).

# App
PORT=8000
REDIS_URL=redis://localhost:6379/0

# Acceso web — generar secretos fuertes (nunca usar los placeholders de abajo en prod)
SITE_USERNAME=despacho
# Texto plano (local) o hash PBKDF2:
#   .venv/bin/python scripts/hash_site_password.py 'tu-secreto'
# Preferir hash PBKDF2 (scripts/hash_site_password.py). Si usa `source .env` en bash,
# NO deje el hash sin comillas: los `$` del hash se expanden y corrompen el secreto.
# Mejor: scripts/lib/load_dotenv.sh o pydantic (src.config) que ya lee .env bien.
# SITE_PASSWORD=pbkdf2_sha256$210000$...
SITE_PASSWORD=genera-un-secreto-local-min-12-chars
# false = sin login en /abogado (local y prod). true = pedir contraseña.
WEB_AUTH_ENABLED=false
# Allowlist IP (CSV). Health /slack /twilio siempre pasan. Localhost OK fuera de Render.
IP_ALLOWLIST_ENABLED=true
IP_ALLOWLIST=66.42.28.38
SESSION_SECRET=genera-un-secreto-aleatorio-min-32-chars
SESSION_IDLE_MINUTES=60
SESSION_MAX_MESSAGES=120
AGENT_MAX_TURNS=25
# En demos locales subir a 12+ si plantillas de 8 pasos se cortan por MaxTurns.
AGENT_MAX_TURNS_PLAN_STEP=6
AGENT_RUN_TIMEOUT_SECONDS=90
# En demos locales subir (p. ej. 180) para memorial/redactor.
AGENT_PLAN_STEP_TIMEOUT_SECONDS=75
AGENT_MAX_RETRIES=1
# 30000 en prod; 0 desactiva el tope (útil en demos locales).
AGENT_MAX_TOTAL_TOKENS=30000
PLAN_STALE_AFTER_SECONDS=300
SESSION_COOKIE_SECURE=false
# Cifrado en reposo (Fernet). Si vacío, se deriva de SESSION_SECRET cuando exista.
# DATA_AT_REST_KEY=genera-otro-secreto-aleatorio-min-32-chars
# Desarrollo local: omitir login manual (solo aplica si WEB_AUTH_ENABLED=true).
DEV_AUTO_LOGIN=true
# Correo con el que /auditoria abre sesión (DEV_AUTO_LOGIN o sin gate).
# DEV_AUDIT_EMAIL=abogada@despacho.com
# false = /auditoria sin login (correo/PIN). true = gate completo.
AUDIT_REQUIRE_LOGIN=false
# APP_DEBUG ya no aplica: la telemetría /debug/* se eliminó del código.

# Portal de auditoría (opcional; CORS para GitHub Pages / preview :8080)
# AUDIT_CORS_ORIGINS=https://rdebiasec.github.io,http://127.0.0.1:8080,http://localhost:8080

# Google Drive Lexiatek — espejo bitácora Gerente (local/dev; sin OAuth)
# Checklist: docs/operaciones/GOOGLE_DRIVE_LEXIATEK.md
# pip install '.[drive]'
GOOGLE_DRIVE_BITACORA_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# JSON de service account (fuera del repo). Alternativa: GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=

# Zona horaria del despacho — saludo de bienvenida en /abogado (buenos días/tardes/noches).
# Default: America/Bogota. Para Orlando (Eastern): America/New_York.
# AGENT_TZ es alias opcional (tiene prioridad si está definido).
# Bogotá vs Orlando se refinará con más detalle más adelante.
DESPACHO_TZ=America/Bogota
# AGENT_TZ=America/New_York

# Twilio StatusCallback — en Render se deduce de RENDER_EXTERNAL_URL si queda vacío:
# TWILIO_STATUS_CALLBACK=https://TU-APP.onrender.com/twilio/sms-status
# Local con túnel (opcional): TWILIO_STATUS_CALLBACK=https://xxxx.ngrok.io/twilio/sms-status
